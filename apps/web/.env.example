DATABASE_URL=postgresql://sife:sife@127.0.0.1:15432/sife
PAYLOAD_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional. Signs Academy course-unlock cookies. Falls back to PAYLOAD_SECRET.
# COURSE_UNLOCK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Staging/production: Render Postgres + Vercel Blob.
# DATABASE_URL=postgresql://USER:PASS@HOST/sife?sslmode=require
# NEXT_PUBLIC_SITE_URL=https://sport-is-for-everyone.vercel.app
# BLOB_READ_WRITE_TOKEN=
# One-time schema push on a fresh DB: PAYLOAD_DATABASE_PUSH=true npm run payload -- run src/scripts/push-schema.ts
# Optional. If unset, /donate uses SIFE support copy and a mail path.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One-time super-admin (never commit these):
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=at-least-12-characters
# Then: npm run payload -- run src/scripts/ensure-super-admin.ts
# Optional editor (defaults to pascagihozo@gmail.com):
# EDITOR_EMAIL=pascagihozo@gmail.com
# EDITOR_PASSWORD=at-least-12-characters
# Keep-alive: GET /api/health runs SELECT 1 against Postgres (used by GitHub Actions every 10 minutes).
# Optional Instagram Graph API. If set, the homepage pulls the live feed (cached 1h).
# Hidden rows in Admin → Instagram posts are excluded by External ID.
# Without a token, published Instagram posts in the CMS are the feed.
# INSTAGRAM_ACCESS_TOKEN=
# Optional. Authorizes GET /api/instagram/sync (Bearer) to upsert live posts into the CMS.
# CRON_SECRET=
# INSTAGRAM_SYNC_SECRET=
